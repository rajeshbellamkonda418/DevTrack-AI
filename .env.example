# Set a unique secret before deploying. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-random-secret

# Keep false for local HTTP development; set true when served over HTTPS.
SESSION_COOKIE_SECURE=false

# SQLite works out of the box for local development. Use MySQL for deployments
# that require a shared persistent database.
DB_BACKEND=sqlite
# DB_BACKEND=mysql
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
